#!/bin/sh
# TS-040 — opt-in: npm run install:git-hooks
# Corre typecheck antes de cada commit (local; não faz parte do CI obrigatório).
# ESLint removido temporariamente: typescript-eslint ainda não suporta TypeScript 7.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: npm run typecheck"
npm run typecheck
echo "pre-commit: OK"
