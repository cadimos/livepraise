{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@shared/*": ["./shared/*"],
      "@core/*": ["./core/*"]
    }
  },
  "include": [
    "apps/operator/**/*.ts",
    "apps/operator/**/*.tsx",
    "apps/operator/**/*.vue",
    "core/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "v0.0.8"]
}
