{
  "name": "livepraise",
  "version": "1.0.0-alpha.1",
  "description": "Live Praise — Software de Projeção para Igrejas",
  "main": "dist/electron/main.js",
  "author": {
    "name": "Thiago de Lucena Sobrinho",
    "email": "thiagolucenaelvis@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "npm run build && node scripts/dev-electron.mjs",
    "start": "npm run dev",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:server": "node scripts/check-node-version.mjs && node scripts/install-yt-dlp.mjs && node scripts/install-ffmpeg.mjs && tsc -p tsconfig.server.json && node -e \"const fs=require('fs');const p='dist/server/db/migrations';fs.mkdirSync(p,{recursive:true});for(const f of fs.readdirSync('server/db/migrations')) fs.copyFileSync('server/db/migrations/'+f,p+'/'+f);\"",
    "build:projector": "tsc -p tsconfig.projector.json",
    "build:stage-return": "tsc -p tsconfig.stage-return.json",
    "build:operator": "vite build --config vite.config.ts",
    "build": "npm run build:server && npm run build:projector && npm run build:stage-return && npm run build:electron && npm run build:operator",
    "dev:server": "npm run build:server && npm run build:operator && node dist/server/index.js",
    "smoke:fase2": "npm run build:server && node scripts/smoke-fase2.mjs",
    "smoke:fase8": "npm run build:server && node scripts/smoke-fase8.mjs",
    "smoke:cad187": "npm run build:server && node scripts/smoke-cad187.mjs",
    "smoke:cad188": "npm run build:server && npm run build:projector && npm run build:stage-return && node scripts/smoke-cad188.mjs",
    "smoke:cad189": "npm run build:server && node scripts/smoke-cad189.mjs",
    "smoke:cad190": "npm run build:server && node scripts/smoke-cad190.mjs",
    "smoke:cad193": "npm run build:server && node scripts/smoke-cad193.mjs",
    "smoke:cad194": "npm run build:server && npm run build:projector && node scripts/smoke-cad194.mjs",
    "smoke:cad221": "npm run build:server && node scripts/smoke-cad221.mjs",
    "smoke:cad224": "npm run build:server && node scripts/smoke-cad224.mjs",
    "smoke:cad221-qa": "npm run smoke:cad221 && npm run smoke:cad224",
    "smoke:cad228": "npm run build:server && node scripts/smoke-cad228.mjs",
    "smoke:cad234": "npm run build:server && node scripts/smoke-cad234.mjs",
    "smoke:cad238": "npm run build:server && node scripts/smoke-cad238.mjs",
    "smoke:cad288": "node scripts/smoke-cad288.mjs",
    "smoke:cad290": "npm run build:server && node scripts/smoke-cad288.mjs && node scripts/smoke-cad290.mjs",
    "smoke:cad300": "npm run build:server && node scripts/smoke-cad300.mjs",
    "smoke:cad311": "npm run build:server && node scripts/smoke-cad311.mjs",
    "smoke:cad313": "npm run build:server && node scripts/smoke-cad313.mjs",
    "smoke:cad314": "npm run build:server && node scripts/smoke-cad314.mjs",
    "test:cad228": "npm run build:server && node tests/security/remote-fetch.test.mjs && node tests/security/remote-fetch-content-type.test.mjs && node tests/error-log/redact-url.test.mjs",
    "verify:cad194-dev": "node scripts/verify-cad194-dev.mjs",
    "test:video-pipeline": "npm run build:server && node scripts/smoke-car40.mjs",
    "smoke:car40": "npm run test:video-pipeline",
    "smoke:bootstrap": "npm run smoke:fase2",
    "smoke:release": "npm run smoke:bootstrap && npm run test:video-pipeline && npm run smoke:fase8",
    "verify:openapi": "node scripts/verify-openapi-coverage.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "dist:win": "npm run build && node scripts/dist-win.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb rpm pacman --x64",
    "dist:linux-appimage": "npm run build && electron-builder --linux AppImage --x64",
    "dist:linux-deb": "npm run build && electron-builder --linux deb --x64",
    "dist:linux-rpm": "npm run build && electron-builder --linux rpm --x64",
    "dist:linux-pacman": "npm run build && electron-builder --linux pacman --x64",
    "dist:flatpak": "npm run build && electron-builder --linux flatpak --x64",
    "dist:snap": "npm run build && electron-builder --linux snap --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:all": "node scripts/dist-all.mjs",
    "postinstall": "node scripts/install-yt-dlp.mjs && node scripts/install-ffmpeg.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.16.0",
    "archiver": "^7.0.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.3",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "fuse.js": "^7.3.0",
    "multer": "^2.1.1",
    "ws": "^8.21.0",
    "yauzl": "^3.3.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.15.21",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-vue": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.11.4",
    "electron": "42.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.4",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue": "^3.4.0",
    "vue-i18n": "^9.14.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cadimos/livepraise.git"
  },
  "homepage": "https://github.com/cadimos/livepraise#readme",
  "depcheck": {
    "ignoreMatches": [
      "autoprefixer",
      "postcss",
      "tailwindcss"
    ],
    "ignorePatterns": [
      "v0.0.8/**",
      "dist/**",
      "release-builds/**"
    ],
    "skipMissing": [
      "node:sqlite",
      "@shared/types"
    ]
  }
}
